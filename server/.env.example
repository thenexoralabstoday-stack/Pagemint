# Copy to .env and fill in.
PORT=4242
APP_URL=http://localhost:8080

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these prices in Stripe → Products. Recurring for monthly/yearly, one-time for weekly.
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_PRO_WEEKLY=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_YEARLY=price_...

# Magic-link email via Resend (https://resend.com). Leave empty to print links to the console in dev.
RESEND_API_KEY=
MAIL_FROM=Pagemint <login@yourdomain.com>

# Claude API for the AI tools (or run `ant auth login` and leave this empty)
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=200
