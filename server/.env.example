# Copy to server/.env for local development. On Render, set these in the dashboard.
PORT=4242
# Public URL of the app. On Render this is detected automatically (RENDER_EXTERNAL_URL).
# APP_URL=https://pagemint.onrender.com

# Signs sign-in links and sessions. Any long random string; keep it secret and stable.
# Render's blueprint generates one for you.
SESSION_SECRET=

# Stripe (https://dashboard.stripe.com/test/apikeys). Use test keys until you are approved.
STRIPE_SECRET_KEY=sk_test_...
# Optional: lets cancellations show up instantly instead of within a minute.
STRIPE_WEBHOOK_SECRET=
# Prices from Stripe -> Product catalogue. Monthly and yearly are recurring; weekly is one-time.
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_PRO_WEEKLY=price_...

# Email via Resend (https://resend.com): sign-in links and contact messages.
# Without it, both are printed to the server log instead.
# To email customers you must verify a domain in Resend and send from it.
RESEND_API_KEY=
MAIL_FROM=Pagemint <login@yourdomain.com>
CONTACT_TO=thenexoralabstoday@gmail.com

# Claude API for the AI tools (or run `ant auth login` and leave this empty)
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=200
